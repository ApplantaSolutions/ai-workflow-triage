# ai-workflow-triage — environment template.
# Copy to .env (git-ignored) and fill values ONLY if you run the real provider.
# The default provider is "mock" and needs none of these; the offline demo and
# the whole test suite run with this file left exactly as-is.

# Anthropic API key — used only with `--provider anthropic` (added in a later checkpoint).
ANTHROPIC_API_KEY=

# Model id for the real provider, e.g. a Claude model name. Blank = provider default.
TRIAGE_MODEL=

# Provider selector: "mock" (default, offline) or "anthropic".
TRIAGE_PROVIDER=mock

# Path to the SQLite audit database. Blank = a local default chosen at runtime.
TRIAGE_DB_PATH=
